# Copy to .env and fill in. Never commit .env.

# LLM providers (free tiers)
GROQ_API_KEY=
GEMINI_API_KEY=

# Channels
TELEGRAM_BOT_TOKEN=

# AWS (credentials come from the local AWS CLI profile, not from this file)
AWS_PROFILE=pramaan
AWS_REGION=ap-south-1

# Public address of this server (used in proof links and QR codes)
PUBLIC_BASE_URL=http://localhost:8000

# Pramaan Desk (bank analyst console) access token
DESK_TOKEN=

# Pramaan Desk lead role (exports, seal revocation)
DESK_LEAD_TOKEN=
# Institutions allowed to issue Pramaan Seals: issuer_id:token,issuer_id:token
ISSUER_TOKENS=
# Banks calling the API without the public rate limit: name:key
PARTNER_KEYS=
